# Shells and Alembic read environment variables; this file is not automatically loaded.
POSTGRES_USER=revenueos
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=revenueos
DATABASE_URL=postgresql+psycopg://revenueos:replace-with-a-local-development-password@127.0.0.1:5432/revenueos
# Use a dedicated disposable DB. Tests refuse non-local targets and require explicit consent.
TEST_DATABASE_URL=postgresql+psycopg://revenueos:replace-with-a-local-development-password@127.0.0.1:5432/revenueos_test
REVENUEOS_TEST_ALLOW_RESET=1

# Optional future live adapter; disabled for this offline increment. Never put real keys in Git.
REVENUEOS_LIVE_ENABLED=0
REVENUEOS_MODEL=
OPENAI_API_KEY=

# Dashboard factory configuration; identity JSON stays server-side.
REVENUEOS_ORIGIN=http://127.0.0.1:8000
REVENUEOS_AUTH_MODE=local
REVENUEOS_STATE_SECRET=replace-with-random-at-least-32-characters
REVENUEOS_IDENTITIES={}
# Google mode requires HTTPS, configured redirect URI /auth/callback, exact hosted domain,
# and a preprovisioned google:SUBJECT mapping to existing DB membership IDs.
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REVENUEOS_STATIC=frontend/dist
# Optional loopback synthetic demo helper: migrate/seed with DATABASE_URL, serve with
# this separately provisioned non-owner login. Hosted web factories use DATABASE_URL
# directly: set that to the runtime login after separate administrator migrations.
REVENUEOS_RUNTIME_DATABASE_URL=

